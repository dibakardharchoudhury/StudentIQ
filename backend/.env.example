# Entra ID: use the tenant ID and API app registration audience for your API.
ENTRA_TENANT_ID=11111111-1111-4111-8111-111111111111
ENTRA_API_AUDIENCE=api://11111111-1111-4111-8111-111111111111
ENTRA_PARENT_OID=22222222-2222-4222-8222-222222222222
# ENTRA_PARENT_OID is the admin allowlisted oid and family storage owner.
# Optional SEPARATE Entra student oid; omit/leave blank for admin-only sign-in.
# This setting does not provision an identity or create a child-usable account.
# ENTRA_STUDENT_OID=33333333-3333-4333-8333-333333333333
# Must exactly match one delegated scope value in the access token's scp claim.
ENTRA_REQUIRED_SCOPE=StudentIQ.Access
# Optional dedicated social clients. Accounts must also be approved by an
# administrator through the API; no social access is granted by default.
# GOOGLE_CLIENT_ID=example.apps.googleusercontent.com
# MICROSOFT_PERSONAL_CLIENT_ID=

# Explicit initial choices, used ONLY when the family preferences Blob is absent.
# Invalid/empty values fail configuration; storage errors never return defaults.
DEFAULT_APPEARANCE=rose
DEFAULT_VOICE=default
DEFAULT_MOOD=gentle
# appearance: rose|sunny|mint; voice: default|alternate; mood: gentle|cheerful|calm.

# Exact HTTPS GitHub Pages origin, e.g. https://example.github.io (no path).
GITHUB_PAGES_ORIGIN=https://example.github.io

# Blob endpoint and pre-created-or-creatable container. Functions identity needs
# Storage Blob Data Contributor. Never put a storage account key here.
AZURE_STORAGE_BLOB_ENDPOINT=https://example.blob.core.windows.net
BLOB_CONTAINER_NAME=studentiq-private
# Optional user-assigned managed identity client ID; omit for system-assigned MI.
# AZURE_CLIENT_ID=

# Azure AI Foundry Model Router resource endpoint. Identity needs inference access.
FOUNDRY_ENDPOINT=https://example.services.ai.azure.com
FOUNDRY_MODEL=model-router
FOUNDRY_API_VERSION=2024-10-21

# Dedicated USER-ASSIGNED identity attached to the Function App, separate from
# its Foundry/Blob identity. Grant only Cognitive Services Speech User on this
# Speech resource; no inherited Foundry/Blob roles. Never re-enable local auth.
SPEECH_IDENTITY_CLIENT_ID=44444444-4444-4444-8444-444444444444
SPEECH_RESOURCE_ID=/subscriptions/11111111-1111-4111-8111-111111111111/resourceGroups/studentiq/providers/Microsoft.CognitiveServices/accounts/studentiq-speech
AZURE_SPEECH_REGION=eastus

# Persistent per-family UTC-day reservations before upstream requests.
# Chat and quiz generation share CHAT_DAILY_LIMIT; student has no separate pool.
# Strict decimal integers only. Zero disables new calls; omit to use defaults.
# CHAT_DAILY_LIMIT range: 0..200; SPEECH_TOKEN_DAILY_LIMIT range: 0..500.
CHAT_DAILY_LIMIT=60
SPEECH_TOKEN_DAILY_LIMIT=200
# These request quotas are NOT hard spend caps: a returned Speech bearer token
# enables direct Speech use until expiry, and Blob/API costs are not capped.
