{
  "version": "2.0",
  "extensions": {
    "http": {
      "maxConcurrentRequests": 20,
      "maxOutstandingRequests": 40,
      "dynamicThrottlesEnabled": true
    }
  },
  "logging": {
    "logLevel": {
      "default": "Warning",
      "Function": "Warning",
      "Host.Results": "Warning",
      "Host.Aggregator": "Warning"
    },
    "applicationInsights": {
      "enableDependencyTracking": false,
      "samplingSettings": {
        "isEnabled": true,
        "maxTelemetryItemsPerSecond": 2
      }
    }
  },
  "functionTimeout": "00:02:00"
}
